# ── Sitio ──────────────────────────────────────────────
# URL pública del sitio (para canonical y og:image absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Teléfono de contacto (CTAs de WhatsApp)
NEXT_PUBLIC_CONTACT_PHONE=

# ── Supabase (fuente del catálogo) ─────────────────────
# Frontend (lectura): publishable/anon key, segura y limitada por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Solo para scripts (seed): NO usar en el frontend.
# SUPABASE_ID basta (deriva la URL) o define SUPABASE_URL completa.
SUPABASE_ID=xxxx
# secret key (Dashboard → Settings → API Keys → secret). Ignora RLS: mantener secreta.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── Strapi (fuente alternativa del CMS) ────────────────
# Local: http://localhost:1337  |  Cloud: https://<proyecto>.strapiapp.com
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
